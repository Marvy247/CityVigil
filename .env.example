# Copy to .env and fill in. .env is git-ignored — never commit a key.
FORTYGUARD_API_KEY=your_api_key_here

# Production. Dev: https://tos-enterprise-api.dev.app.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Where cached API responses are written. Committed cache = offline replay.
CITYVIGIL_CACHE_DIR=data/cache

# "live"    - call the API, write results to cache
# "replay"  - never call the API; cache miss is an error (judge-friendly default)
# "refresh" - ignore cache, always call, overwrite
CITYVIGIL_CACHE_MODE=live
